APP_ENV=development

# LLM providers: groq | gemini | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ServiceNow: mock | live
SERVICENOW_MODE=mock
SN_INSTANCE=https://devXXXXX.service-now.com
SN_USER=helpdesk_agent_svc
SN_PASSWORD=

# Data stores
MONGODB_URI=mongodb://localhost:27017/nexusdesk
CHROMA_PATH=./chroma_data

# Security
JWT_SECRET=change-me
